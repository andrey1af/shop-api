POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me

# Used by api-service when it is started locally. Docker Compose replaces the
# host with the postgres service name.
DATABASE_URL=postgres://shop:change-me@localhost:5432/shop?sslmode=disable

DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

API_PORT=8080
HTTP_ADDRESS=:8090
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=5s
